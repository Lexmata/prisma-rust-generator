enum CaseStatus {
  INTAKE
  INVESTIGATION
  ACTIVE_LITIGATION
  SETTLEMENT_NEGOTIATION
  RESOLVED
  CLOSED
  ARCHIVED
}

enum TreatmentStatus {
  ACTIVE_TREATMENT
  COMPLETED
  ONGOING
  UNKNOWN
}

enum CoverageType {
  LIABILITY
  PIP_NO_FAULT
  UM_UIM
  MEDPAY
  OTHER_COVERAGE
}

enum OpposingPartyType {
  INDIVIDUAL
  CORPORATION
  GOVERNMENT_ENTITY
  OTHER_PARTY
}

enum CaseTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETE
}

enum CaseTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CalendarEntryType {
  STATUTE_OF_LIMITATIONS
  HEARING_DATE
  DEPOSITION
  FILING_DEADLINE
  MEDICAL_APPOINTMENT
  CUSTOM
}

enum ContactRole {
  PLAINTIFF
  DEFENDANT
  ATTORNEY_PLAINTIFF
  ATTORNEY_DEFENSE
  WITNESS
  EXPERT_WITNESS
  MEDICAL_PROVIDER
  INSURANCE_ADJUSTER
  JUDGE
  CUSTOM_ROLE
}

enum BillingExpenseCategory {
  FILING_FEES
  EXPERT_FEES
  COURT_COSTS
  TRAVEL
  COPYING
  POSTAGE
  OTHER_EXPENSE
}

model Case {
  id         String   @id @default(uuid()) @map("id") @db.Uuid
  identifier String   @map("identifier") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  firmId     String   @map("firm_id") @db.Uuid
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Case management fields
  status          CaseStatus @default(INTAKE) @map("status")
  referenceNumber String?    @map("reference_number") @db.VarChar(100)
  description     String?    @map("description") @db.Text
  tortType        TortType?  @map("tort_type")
  dateOfIncident  DateTime?  @map("date_of_incident") @db.Timestamp(6)
  assignedUserId  String?    @map("assigned_user_id") @db.Uuid
  assignedUser    User?      @relation("assignedCases", fields: [assignedUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  theoryOfTheCase String?    @map("theory_of_the_case") @db.Text
  initialNotes    String?    @map("initial_notes") @db.Text

  // Client information
  clientFirstName            String?   @map("client_first_name") @db.VarChar(100)
  clientLastName             String?   @map("client_last_name") @db.VarChar(100)
  clientDob                  DateTime? @map("client_dob") @db.Date
  clientPhone                String?   @map("client_phone") @db.VarChar(20)
  clientEmail                String?   @map("client_email") @db.VarChar(255)
  /// Encrypted at the application layer before write. The 512-character
  /// VARCHAR accommodates the ciphertext produced by the backend's envelope
  /// encryption; consumers MUST NEVER write plaintext here. The `_encrypted`
  /// suffix makes the contract explicit — same pattern as
  /// `AdvitaConnection.apiKeyEncrypted`.
  clientSsnEncrypted         String?   @map("client_ssn_encrypted") @db.VarChar(512)
  /// "last four" refers to the plaintext semantic (last four digits of the SSN).
  /// The column width is sized for the *encrypted* form of that 4-char value,
  /// which is significantly larger than 4 bytes once wrapped in the envelope.
  clientSsnLastFourEncrypted String?   @map("client_ssn_last_four_encrypted") @db.VarChar(512)
  clientAddressLine1         String?   @map("client_address_line1") @db.VarChar(255)
  clientAddressLine2         String?   @map("client_address_line2") @db.VarChar(255)
  clientCity                 String?   @map("client_city") @db.VarChar(100)
  clientState                String?   @map("client_state") @db.VarChar(2)
  clientZip                  String?   @map("client_zip") @db.VarChar(10)

  // Accident / Incident details
  incidentLocation    String?  @map("incident_location") @db.VarChar(500)
  policeReportNumber  String?  @map("police_report_number") @db.VarChar(100)
  incidentDescription String?  @map("incident_description") @db.Text
  weatherConditions   String?  @map("weather_conditions") @db.VarChar(255)
  witnessAtScene      Boolean? @map("witness_at_scene") @db.Boolean
  witnessNotes        String?  @map("witness_notes") @db.Text
  photosAvailable     Boolean? @map("photos_available") @db.Boolean
  photosNotes         String?  @map("photos_notes") @db.Text

  // Injury & Medical
  injuredBodyParts      Json?            @map("injured_body_parts") @db.JsonB
  preExistingConditions String?          @map("pre_existing_conditions") @db.Text
  treatmentStartDate    DateTime?        @map("treatment_start_date") @db.Date
  treatmentEndDate      DateTime?        @map("treatment_end_date") @db.Date
  knownProviders        Json?            @map("known_providers") @db.JsonB
  initialDiagnosis      String?          @map("initial_diagnosis") @db.Text
  treatmentStatus       TreatmentStatus? @map("treatment_status")

  // Insurance
  clientInsuranceCompany   String?       @map("client_insurance_company") @db.VarChar(255)
  clientPolicyNumber       String?       @map("client_policy_number") @db.VarChar(100)
  clientClaimNumber        String?       @map("client_claim_number") @db.VarChar(100)
  coverageType             CoverageType? @map("coverage_type")
  clientPolicyLimits       Decimal?      @map("client_policy_limits") @db.Decimal(12, 2)
  opposingInsuranceCompany String?       @map("opposing_insurance_company") @db.VarChar(255)
  opposingClaimNumber      String?       @map("opposing_claim_number") @db.VarChar(100)
  opposingPolicyLimits     Decimal?      @map("opposing_policy_limits") @db.Decimal(12, 2)
  adjusterName             String?       @map("adjuster_name") @db.VarChar(255)
  adjusterPhone            String?       @map("adjuster_phone") @db.VarChar(20)
  adjusterEmail            String?       @map("adjuster_email") @db.VarChar(255)

  // Opposing Party
  opposingPartyName       String?            @map("opposing_party_name") @db.VarChar(255)
  opposingPartyType       OpposingPartyType? @map("opposing_party_type")
  opposingCounselFirm     String?            @map("opposing_counsel_firm") @db.VarChar(255)
  opposingCounselAttorney String?            @map("opposing_counsel_attorney") @db.VarChar(255)
  opposingCounselPhone    String?            @map("opposing_counsel_phone") @db.VarChar(20)
  opposingCounselEmail    String?            @map("opposing_counsel_email") @db.VarChar(255)

  // Existing relations
  documents               Document[]
  demandLetters           DemandLetter[]
  batchFiles              BatchFile[]
  searchProcessings       SearchProcessing[]
  initialCaseEvaluation   InitialCaseEvaluationProcessing?
  demandLetterProcessings DemandLetterProcessing[]
  caseReviewProcessings   CaseReviewProcessing[]
  advitaCaseMappings      AdvitaCaseMapping[]
  caseQualifications      CaseQualification[]
  qualifyAiProcessing     QualifyAiProcessing[]
  invoices                Invoice[]

  // New case management relations
  caseNotes              CaseNote[]
  caseTasks              CaseTask[]
  caseCalendarEntries    CaseCalendarEntry[]
  caseContacts           CaseContact[]
  caseBillingTimeEntries CaseBillingTimeEntry[]
  caseBillingExpenses    CaseBillingExpense[]

  @@index([firmId], map: "case_firm_id_idx")
  @@index([status], map: "case_status_idx")
  @@index([assignedUserId], map: "case_assigned_user_idx")
  @@index([tortType], map: "case_tort_type_idx")
  @@map("cases")
}

model CaseNote {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  caseId    String   @map("case_id") @db.Uuid
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  firmId    String   @map("firm_id") @db.Uuid
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  title     String   @map("title") @db.VarChar(255)
  body      String   @map("body") @db.Text
  isPinned  Boolean  @default(false) @map("is_pinned") @db.Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([caseId], map: "case_note_case_id_idx")
  @@index([firmId], map: "case_note_firm_id_idx")
  @@map("case_notes")
}

model CaseTask {
  id          String           @id @default(uuid()) @map("id") @db.Uuid
  caseId      String           @map("case_id") @db.Uuid
  case        Case             @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  firmId      String           @map("firm_id") @db.Uuid
  firm        Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdById String           @map("created_by_id") @db.Uuid
  createdBy   User             @relation("caseTaskCreator", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assigneeId  String?          @map("assignee_id") @db.Uuid
  assignee    User?            @relation("caseTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  title       String           @map("title") @db.VarChar(255)
  description String?          @map("description") @db.Text
  status      CaseTaskStatus   @default(OPEN) @map("status")
  priority    CaseTaskPriority @default(MEDIUM) @map("priority")
  dueDate     DateTime?        @map("due_date") @db.Timestamp(6)
  completedAt DateTime?        @map("completed_at") @db.Timestamp(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([caseId], map: "case_task_case_id_idx")
  @@index([firmId], map: "case_task_firm_id_idx")
  @@index([assigneeId], map: "case_task_assignee_id_idx")
  @@map("case_tasks")
}

model CaseCalendarEntry {
  id          String            @id @default(uuid()) @map("id") @db.Uuid
  caseId      String            @map("case_id") @db.Uuid
  case        Case              @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  firmId      String            @map("firm_id") @db.Uuid
  firm        Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  entryType   CalendarEntryType @map("entry_type")
  title       String            @map("title") @db.VarChar(255)
  description String?           @map("description") @db.Text
  date        DateTime          @map("date") @db.Timestamp(6)
  hasReminder Boolean           @default(false) @map("has_reminder") @db.Boolean
  reminderAt  DateTime?         @map("reminder_at") @db.Timestamp(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([caseId], map: "case_calendar_entry_case_id_idx")
  @@index([firmId], map: "case_calendar_entry_firm_id_idx")
  @@index([date], map: "case_calendar_entry_date_idx")
  @@map("case_calendar_entries")
}

model CaseContact {
  id           String      @id @default(uuid()) @map("id") @db.Uuid
  caseId       String      @map("case_id") @db.Uuid
  case         Case        @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  firmId       String      @map("firm_id") @db.Uuid
  firm         Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role         ContactRole @map("role")
  customRole   String?     @map("custom_role") @db.VarChar(100)
  firstName    String      @map("first_name") @db.VarChar(100)
  lastName     String      @map("last_name") @db.VarChar(100)
  organization String?     @map("organization") @db.VarChar(255)
  email        String?     @map("email") @db.VarChar(255)
  phone        String?     @map("phone") @db.VarChar(20)
  addressLine1 String?     @map("address_line1") @db.VarChar(255)
  addressLine2 String?     @map("address_line2") @db.VarChar(255)
  city         String?     @map("city") @db.VarChar(100)
  state        String?     @map("state") @db.VarChar(2)
  zip          String?     @map("zip") @db.VarChar(10)
  notes        String?     @map("notes") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([caseId], map: "case_contact_case_id_idx")
  @@index([firmId], map: "case_contact_firm_id_idx")
  @@map("case_contacts")
}

model CaseBillingTimeEntry {
  id          String   @id @default(uuid()) @map("id") @db.Uuid
  caseId      String   @map("case_id") @db.Uuid
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  firmId      String   @map("firm_id") @db.Uuid
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  date        DateTime @map("date") @db.Date
  hours       Decimal  @map("hours") @db.Decimal(5, 2)
  description String   @map("description") @db.Text
  isBillable  Boolean  @default(true) @map("is_billable") @db.Boolean
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([caseId], map: "case_billing_time_entry_case_id_idx")
  @@index([firmId], map: "case_billing_time_entry_firm_id_idx")
  @@index([userId], map: "case_billing_time_entry_user_id_idx")
  @@map("case_billing_time_entries")
}

model CaseBillingExpense {
  id          String                 @id @default(uuid()) @map("id") @db.Uuid
  caseId      String                 @map("case_id") @db.Uuid
  case        Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  firmId      String                 @map("firm_id") @db.Uuid
  firm        Firm                   @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  date        DateTime               @map("date") @db.Date
  description String                 @map("description") @db.Text
  amount      Decimal                @map("amount") @db.Decimal(10, 2)
  category    BillingExpenseCategory @map("category")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([caseId], map: "case_billing_expense_case_id_idx")
  @@index([firmId], map: "case_billing_expense_firm_id_idx")
  @@map("case_billing_expenses")
}
