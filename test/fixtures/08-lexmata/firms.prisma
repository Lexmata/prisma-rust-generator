// Firms, firm roles, permissions, SSO config, invitations, document types.

enum SSOProvider {
  AZURE_AD
  GOOGLE_WORKSPACE
  LINKEDIN
  OKTA
}

model Firm {
  id                          String                            @id @default(uuid()) @map("id") @db.Uuid
  name                        String                            @map("name") @db.VarChar(255)
  phoneNumber                 String?                           @map("phone_number") @db.VarChar(255)
  faxNumber                   String?                           @map("fax_number") @db.VarChar(255)
  createdAt                   DateTime                          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                   DateTime                          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  addressId                   String?                           @unique(map: "firms_address_id_key") @map("address_id") @db.Uuid
  address                     Address?                          @relation(fields: [addressId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                       User[]                            @relation("members")
  ownerId                     String?                           @unique @map("owner_id") @db.Uuid
  owner                       User?                             @relation("ownerFirm", fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tier                        SubscriptionTier                  @default(None)
  hasFreeDemoOCR              Boolean                           @default(true) @map("has_free_demo_ocr") @db.Boolean
  hasFreeDemoIdentification   Boolean                           @default(true) @map("has_free_demo_identification") @db.Boolean
  documents                   Document[]
  cases                       Case[]
  demandLetters               DemandLetter[]
  searchProcessings           SearchProcessing[]
  searchTemplates             DocumentSearchTemplate[]          @relation("document_search_templates")
  requireMfa                  Boolean                           @default(false) @map("require_mfa") @db.Boolean
  ssoConfigs                  FirmSSOConfig[]
  invoices                    Invoice[]
  initialCaseEvaluations      InitialCaseEvaluationProcessing[]
  demandLetterProcessings     DemandLetterProcessing[]
  caseReviewProcessings       CaseReviewProcessing[]
  formTemplates               FormTemplate[]
  formDistributions           FormDistribution[]
  formSubmissions             FormSubmission[]
  pdfUploads                  PdfUpload[]
  notifications               Notification[]
  emailDeliveries             EmailDelivery[]
  firmRoles                   FirmRole[]
  defaultRoleId               String?                           @map("default_role_id") @db.Uuid
  defaultRole                 FirmRole?                         @relation("defaultFirmRole", fields: [defaultRoleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  advitaConnection            AdvitaConnection?
  advitaCaseMappings          AdvitaCaseMapping[]
  advitaTrackingMappings      AdvitaTrackingMapping[]
  qualificationCriteria       QualificationCriteria[]
  caseQualifications          CaseQualification[]
  tortTemplates               TortTemplate[]                    @relation("firmTortTemplates")
  qualifyAiDemoUsed           Boolean                           @default(false) @map("qualify_ai_demo_used") @db.Boolean
  qualifyAiProcessing         QualifyAiProcessing[]
  qualifyAiQualifierDocuments QualifyAiQualifierDocument[]
  firmInvitations             FirmInvitation[]
  firmDocumentTypes           FirmDocumentType[]
  caseNotes                   CaseNote[]
  caseTasks                   CaseTask[]
  caseCalendarEntries         CaseCalendarEntry[]
  caseContacts                CaseContact[]
  caseBillingTimeEntries      CaseBillingTimeEntry[]
  caseBillingExpenses         CaseBillingExpense[]
  externalPlatformConnections ExternalPlatformConnection[]

  @@map("firms")
}

model FirmRole {
  id              String               @id @default(uuid()) @map("id") @db.Uuid
  firmId          String               @map("firm_id") @db.Uuid
  firm            Firm                 @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name            String               @map("name") @db.VarChar(100)
  description     String?              @map("description") @db.Text
  isSystem        Boolean              @default(false) @map("is_system") @db.Boolean
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  permissions     FirmRolePermission[]
  users           User[]               @relation("userFirmRole")
  defaultForFirms Firm[]               @relation("defaultFirmRole")
  firmInvitations FirmInvitation[]

  @@unique([firmId, name], map: "firm_role_firm_name_unique")
  @@index([firmId], map: "firm_role_firm_id_idx")
  @@map("firm_roles")
}

model FirmRolePermission {
  id         String   @id @default(uuid()) @map("id") @db.Uuid
  firmRoleId String   @map("firm_role_id") @db.Uuid
  firmRole   FirmRole @relation(fields: [firmRoleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  action     String   @map("action") @db.VarChar(50)
  subject    String   @map("subject") @db.VarChar(100)
  conditions Json?    @map("conditions") @db.JsonB
  fields     Json?    @map("fields") @db.JsonB
  inverted   Boolean  @default(false) @map("inverted") @db.Boolean
  reason     String?  @map("reason") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([firmRoleId], map: "firm_role_permission_role_id_idx")
  @@map("firm_role_permissions")
}

model Role {
  id       Int    @id @default(autoincrement()) @map("id")
  roleName String @map("role_name") @db.VarChar(20)

  @@map("rb_user_roles")
}

model FirmSSOConfig {
  id        String      @id @default(uuid()) @map("id") @db.Uuid
  firmId    String      @map("firm_id") @db.Uuid
  provider  SSOProvider @map("provider")
  isEnabled Boolean     @default(false) @map("is_enabled")

  // Common SSO fields
  entityId        String  @map("entity_id") @db.VarChar(255)
  loginUrl        String  @map("login_url") @db.VarChar(255)
  logoutUrl       String? @map("logout_url") @db.VarChar(255)
  certificateData String  @map("certificate_data") @db.Text

  // Azure AD specific fields. `*_encrypted` columns hold the
  // ciphertext produced by the backend's envelope encryption — the
  // varchar width is sized for ciphertext, not cleartext. Consumers
  // MUST NEVER write plaintext. Same pattern as
  // `AdvitaConnection.apiKeyEncrypted`.
  tenantId              String? @map("tenant_id") @db.VarChar(36)
  clientId              String? @map("client_id") @db.VarChar(36)
  clientSecretEncrypted String? @map("client_secret_encrypted") @db.VarChar(1024)

  // Google Workspace specific fields
  googleDomain                String? @map("google_domain") @db.VarChar(255)
  googleClientId              String? @map("google_client_id") @db.VarChar(255)
  googleClientSecretEncrypted String? @map("google_client_secret_encrypted") @db.VarChar(1024)

  // LinkedIn specific fields
  linkedInOrganizationId        String? @map("linkedin_organization_id") @db.VarChar(255)
  linkedInClientId              String? @map("linkedin_client_id") @db.VarChar(255)
  linkedInClientSecretEncrypted String? @map("linkedin_client_secret_encrypted") @db.VarChar(1024)
  linkedInApiUrl                String? @map("linkedin_api_url") @db.VarChar(255)

  // Okta specific fields
  oktaDomain                String? @map("okta_domain") @db.VarChar(255)
  oktaOrgUrl                String? @map("okta_org_url") @db.VarChar(255)
  oktaClientId              String? @map("okta_client_id") @db.VarChar(255)
  oktaClientSecretEncrypted String? @map("okta_client_secret_encrypted") @db.VarChar(1024)
  oktaApiTokenEncrypted     String? @map("okta_api_token_encrypted") @db.VarChar(1024)
  oktaGroupId               String? @map("okta_group_id") @db.VarChar(255)
  oktaAppId                 String? @map("okta_app_id") @db.VarChar(255)

  // Trust the IdP's own MFA enforcement (skip Cognito MFA for federated users)
  trustIdpMfa Boolean @default(false) @map("trust_idp_mfa") @db.Boolean

  // Metadata
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  lastSynced DateTime? @map("last_synced") @db.Timestamp(6)

  // Relations
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([firmId, provider], map: "firm_sso_provider_unique")
  @@index([firmId], map: "firm_sso_config_firm_id_idx")
  @@map("firm_sso_configs")
}

model FirmInvitation {
  id           String    @id @default(uuid()) @db.Uuid
  firmId       String    @map("firm_id") @db.Uuid
  firm         Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  email        String    @map("email") @db.VarChar(255)
  codeHash     String    @map("code_hash") @db.VarChar(64)
  roleId       String?   @map("role_id") @db.Uuid
  role         FirmRole? @relation(fields: [roleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  invitedById  String    @map("invited_by_id") @db.Uuid
  invitedBy    User      @relation("FirmInvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  acceptedById String?   @map("accepted_by_id") @db.Uuid
  acceptedBy   User?     @relation("FirmInvitationsAccepted", fields: [acceptedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  expiresAt    DateTime  @map("expires_at") @db.Timestamp(6)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamp(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([firmId], map: "firm_invitation_firm_id_idx")
  @@index([email], map: "firm_invitation_email_idx")
  @@index([expiresAt], map: "firm_invitation_expires_at_idx")
  @@map("firm_invitations")
}

// ─── Case Management Models ──────────────────────────────────────────────────

model FirmDocumentType {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  firmId    String   @map("firm_id") @db.Uuid
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name      String   @map("name") @db.VarChar(255)
  color     String?  @map("color") @db.VarChar(7)
  isActive  Boolean  @default(true) @map("is_active") @db.Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([firmId, name], map: "firm_document_type_firm_name_uq")
  @@index([firmId], map: "firm_document_type_firm_id_idx")
  @@map("firm_document_types")
}
