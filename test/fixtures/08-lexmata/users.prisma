// Users and user-scoped onboarding state.

enum SubscriptionTier {
  None
  Small
  Medium
  Large
  BigLaw
  Unlimited
}

model User {
  id                               String                            @id @default(uuid()) @map("id") @db.Uuid
  firstName                        String                            @map("first_name") @db.VarChar(50)
  lastName                         String                            @map("last_name") @db.VarChar(50)
  phoneNumber                      String                            @map("phone_number") @db.Char(10)
  email                            String                            @unique(map: "idx_email") @map("email") @db.VarChar(50)
  unlimitedAccess                  Boolean                           @default(false) @map("unlimited_access") @db.Boolean
  token                            String?                           @map("token") @db.VarChar(32)
  userActive                       Boolean                           @default(true) @map("user_active")
  roleId                           Int?                              @default(5) @map("role_id") @db.Integer
  clientId                         Int?                              @map("client_id") @db.Integer
  createdAt                        DateTime                          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                        DateTime                          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  lastLoginAt                      DateTime?                         @map("last_login_at") @db.Timestamp(6)
  stripeCustomerId                 String?                           @map("stripe_customer_id") @db.VarChar(45)
  pageCredits                      Int                               @default(0) @map("page_credits") @db.Integer
  batchFile                        BatchFile[]                       @relation("batch_file")
  document                         Document[]                        @relation("documents")
  documentSearchTemplates          DocumentSearchTemplate[]          @relation("document_search_templates")
  documentTags                     DocumentTag[]                     @relation("document_tags")
  isConverted                      Boolean                           @default(false) @map("is_converted")
  onboardingCompleted              Boolean                           @default(false) @map("onboarding_completed") @db.Boolean
  onboardingCompletedAt            DateTime?                         @map("onboarding_completed_at") @db.Timestamp(6)
  mfaEnabled                       Boolean                           @default(false) @map("mfa_enabled") @db.Boolean
  mfaSetupDismissedAt              DateTime?                         @map("mfa_setup_dismissed_at") @db.Timestamp(6)
  cookiePolicyAcceptedAt           DateTime?                         @map("cookie_policy_accepted_at") @db.Timestamp(6)
  cognitoSub                       String?                           @map("cognito_sub") @db.VarChar(255)
  firmId                           String?                           @map("firm_id") @db.Uuid
  firm                             Firm?                             @relation("members", fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  firmRoleId                       String?                           @map("firm_role_id") @db.Uuid
  firmRole                         FirmRole?                         @relation("userFirmRole", fields: [firmRoleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  ownedFirm                        Firm?                             @relation("ownerFirm")
  invoices                         Invoice[]
  passwordRecovery                 PasswordRecovery[]
  initialCaseEvaluationProcessings InitialCaseEvaluationProcessing[]
  onboardingFeatures               UserOnboardingFeature[]
  mfaRecoveryCodes                 MfaRecoveryCode[]
  formTemplates                    FormTemplate[]                    @relation("formTemplateCreator")
  formDistributions                FormDistribution[]                @relation("formDistributionCreator")
  verifiedSubmissions              FormSubmission[]                  @relation("formSubmissionVerifier")
  submissionNotes                  SubmissionNote[]                  @relation("submissionNoteCreator")
  fieldReviews                     ExtractedFieldReview[]            @relation("fieldReviewReviewer")
  notifications                    Notification[]                    @relation("notificationRecipient")
  notificationPreferences          NotificationPreference[]          @relation("notificationPreference")
  emailVerifications               EmailVerification[]
  qualifyAiProcessing              QualifyAiProcessing[]
  qualifyAiUploads                 QualifyAiQualifierDocument[]      @relation("qualifyAiUploads")
  firmInvitationsSent              FirmInvitation[]                  @relation("FirmInvitationsSent")
  firmInvitationsAccepted          FirmInvitation[]                  @relation("FirmInvitationsAccepted")
  assignedCases                    Case[]                            @relation("assignedCases")
  caseNotes                        CaseNote[]
  caseTasksCreated                 CaseTask[]                        @relation("caseTaskCreator")
  caseTasksAssigned                CaseTask[]                        @relation("caseTaskAssignee")
  caseBillingTimeEntries           CaseBillingTimeEntry[]

  @@index([firmRoleId], map: "users_firm_role_id_idx")
  @@map("users")
}

model UserOnboardingFeature {
  id          String    @id @default(uuid()) @map("id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  featureKey  String    @map("feature_key") @db.VarChar(100)
  completed   Boolean   @default(false) @map("completed") @db.Boolean
  completedAt DateTime? @map("completed_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([userId, featureKey], map: "user_onboarding_feature_user_feature_unique")
  @@index([userId], map: "user_onboarding_feature_user_id_idx")
  @@index([featureKey], map: "user_onboarding_feature_feature_key_idx")
  @@map("user_onboarding_features")
}
