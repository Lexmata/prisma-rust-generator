// Auth, sessions, MFA, email verification, password recovery, downloads.

enum EmailVerificationType {
  SIGN_UP
  PASSWORD_RESET
}

model PasswordRecovery {
  id        String   @id @default(cuid()) @map("id") @db.VarChar(25)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  expires   DateTime @map("expires_at") @db.Timestamp(6)

  @@map("password_recoveries")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @map("id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  codeHash  String    @map("code_hash") @db.VarChar(128)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([userId], map: "mfa_recovery_codes_user_id_idx")
  @@map("mfa_recovery_codes")
}

model EmailVerification {
  id          String                @id @default(cuid()) @map("id") @db.VarChar(25)
  email       String                @map("email") @db.VarChar(255)
  codeHash    String                @map("code_hash") @db.VarChar(64)
  type        EmailVerificationType @map("type")
  attempts    Int                   @default(0) @map("attempts") @db.Integer
  maxAttempts Int                   @default(5) @map("max_attempts") @db.Integer
  expiresAt   DateTime              @map("expires_at") @db.Timestamp(6)
  usedAt      DateTime?             @map("used_at") @db.Timestamp(6)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  userId      String                @map("user_id") @db.Uuid
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email, type], map: "email_verification_email_type_idx")
  @@index([expiresAt], map: "email_verification_expires_at_idx")
  @@map("email_verifications")
}

model DownloadLink {
  id        String   @id @default(cuid())
  s3Bucket  String   @map("s3_bucket") @db.VarChar(255)
  s3Key     String   @map("s3_key") @db.VarChar(1024)
  fileName  String?  @map("file_name") @db.VarChar(255)
  firmId    String   @map("firm_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([firmId], map: "download_link_firm_id_idx")
  @@index([expiresAt], map: "download_link_expires_at_idx")
  @@map("download_links")
}

model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  createdBy  String    @map("created_by") @db.VarChar(255)
  revoked    Boolean   @default(false)
  expiresAt  DateTime? @map("expires_at") @db.Timestamp(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([tokenHash], map: "api_token_hash_idx")
  @@map("api_tokens")
}
