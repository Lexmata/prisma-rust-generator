// Async case-processing pipelines: qualify-ai, search, evaluation, reviews.

enum ProcessingStatus {
  NOT_REQUESTED
  PENDING
  PROCESSING
  COMPLETE
  ERROR
}

enum CaseReviewAudience {
  ATTORNEY
  PARALEGAL
  MARKETING
}

enum ProcessingTier {
  IDENTIFICATION
  ORGANIZATION
  SUMMARIZATION
}

model SearchProcessing {
  id                          Int              @id @default(autoincrement()) @map("id")
  documentId                  String           @map("document_id") @db.Uuid
  batchId                     String?          @map("batch_id") @db.Uuid
  /// @ent.json array
  searchTypes                 Json             @map("search_types") @db.JsonB
  /// @ent.json array
  searchTerms                 Json?            @map("search_terms") @db.JsonB
  fileCount                   Int?             @map("file_count")
  processingTier              ProcessingTier   @default(IDENTIFICATION) @map("processing_tier")
  ocrStatus                   ProcessingStatus @default(PENDING) @map("ocr_status")
  processingStatus            ProcessingStatus @default(PENDING) @map("processing_status")
  organizationStatus          ProcessingStatus @default(NOT_REQUESTED) @map("organization_status")
  summarizationStatus         ProcessingStatus @default(NOT_REQUESTED) @map("summarization_status")
  startedAt                   DateTime?        @map("started_at") @db.Timestamp(6)
  completedAt                 DateTime?        @map("completed_at") @db.Timestamp(6)
  organizationStartedAt       DateTime?        @map("organization_started_at") @db.Timestamp(6)
  organizationCompletedAt     DateTime?        @map("organization_completed_at") @db.Timestamp(6)
  summarizationStartedAt      DateTime?        @map("summarization_started_at") @db.Timestamp(6)
  summarizationCompletedAt    DateTime?        @map("summarization_completed_at") @db.Timestamp(6)
  summarizationOutputFilePath String?          @map("summarization_output_file_path") @db.VarChar(500)
  /// @ent.json array
  notificationEmail           Json?            @map("notification_email")
  /// @ent.json array
  redactionTerms              Json?            @map("redaction_terms") @db.JsonB
  createdAt                   DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  document                    Document         @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  processingMessage           String?          @map("processing_message") @db.Text
  firmId                      String?          @map("firm_id") @db.Uuid
  firm                        Firm?            @relation(fields: [firmId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  caseId                      String?          @map("case_id") @db.Uuid
  case                        Case?            @relation(fields: [caseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /// @ent.json object
  sqsMessage                  Json?            @map("sqs_message") @db.JsonB

  @@index([firmId], map: "search_processing_firm_id_idx")
  @@index([caseId], map: "search_processing_case_id_idx")
  @@map("search_processings")
}

model InitialCaseEvaluationProcessing {
  id                      Int              @id @default(autoincrement()) @map("id")
  caseId                  String           @unique @map("case_id") @db.Uuid
  case                    Case             @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  firmId                  String           @map("firm_id") @db.Uuid
  firm                    Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId                  String           @map("user_id") @db.Uuid
  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  processingStatus        ProcessingStatus @default(PENDING) @map("processing_status")
  sqsMessageId            String?          @map("sqs_message_id") @db.VarChar(255)
  theoryOfTheCase         String?          @map("theory_of_the_case") @db.Text
  outputFilePath          String?          @map("output_file_path") @db.VarChar(500)
  startedAt               DateTime?        @map("started_at") @db.Timestamp(6)
  completedAt             DateTime?        @map("completed_at") @db.Timestamp(6)
  processingStatusMessage String?          @map("processing_status_message") @db.VarChar(255)
  errorMessage            String?          @map("error_message") @db.Text
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  // Intake fields for RAG context (stored in DB, fetched by Go processor)
  dateOfIncident        DateTime? @map("date_of_incident") @db.Date
  tortType              TortType? @map("tort_type")
  clientName            String?   @map("client_name") @db.VarChar(255)
  /// @ent.json array
  injuredBodyParts      Json?     @map("injured_body_parts") @db.JsonB
  preExistingConditions String?   @map("pre_existing_conditions") @db.Text
  /// @ent.json array
  knownProviders        Json?     @map("known_providers") @db.JsonB
  treatmentStartDate    DateTime? @map("treatment_start_date") @db.Date
  treatmentEndDate      DateTime? @map("treatment_end_date") @db.Date

  @@index([firmId], map: "initial_case_evaluation_processing_firm_id_idx")
  @@index([userId], map: "initial_case_evaluation_processing_user_id_idx")
  @@index([processingStatus], map: "initial_case_evaluation_processing_status_idx")
  @@map("initial_case_evaluation_processings")
}

model CaseReviewProcessing {
  id                      Int                @id @default(autoincrement()) @map("id")
  caseId                  String             @map("case_id") @db.Uuid
  case                    Case               @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  firmId                  String             @map("firm_id") @db.Uuid
  firm                    Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  audience                CaseReviewAudience @map("audience")
  processingStatus        ProcessingStatus   @default(PENDING) @map("processing_status")
  startedAt               DateTime?          @default(now()) @map("started_at") @db.Timestamp(6)
  completedAt             DateTime?          @map("completed_at") @db.Timestamp(6)
  processingStatusMessage String?            @map("processing_status_message") @db.VarChar(255)
  m4aPath                 String?            @map("m4a_path") @db.VarChar(1024)
  transcriptPath          String?            @map("transcript_path") @db.VarChar(1024)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([caseId, audience], map: "case_review_processing_case_audience_uniq")
  @@index([firmId], map: "case_review_processing_firm_id_idx")
  @@index([caseId], map: "case_review_processing_case_id_idx")
  @@map("case_review_processings")
}

model QualifyAiProcessing {
  id                        String                       @id @default(uuid()) @db.Uuid
  caseId                    String                       @map("case_id") @db.Uuid
  case                      Case                         @relation(fields: [caseId], references: [id])
  firmId                    String                       @map("firm_id") @db.Uuid
  firm                      Firm                         @relation(fields: [firmId], references: [id])
  userId                    String                       @map("user_id") @db.Uuid
  user                      User                         @relation(fields: [userId], references: [id])
  invoiceId                 String                       @map("invoice_id") @db.Uuid
  invoice                   Invoice                      @relation(fields: [invoiceId], references: [id])
  nurseReview               Boolean                      @default(false) @map("nurse_review")
  generateQualificationMemo Boolean                      @default(true) @map("generate_qualification_memo")
  pageCount                 Int                          @map("page_count")
  processingStatus          ProcessingStatus             @default(PENDING) @map("processing_status")
  sqsMessageId              String?                      @map("sqs_message_id") @db.VarChar(255)
  errorMessage              String?                      @map("error_message") @db.Text
  excelOutputKey            String?                      @map("excel_output_key") @db.VarChar(1024)
  docxOutputKey             String?                      @map("docx_output_key") @db.VarChar(1024)
  startedAt                 DateTime                     @default(now()) @map("started_at") @db.Timestamp(6)
  completedAt               DateTime?                    @map("completed_at") @db.Timestamp(6)
  createdAt                 DateTime                     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  processedDocuments        QualifyAiProcessedDocument[]

  @@index([caseId], map: "qualify_ai_processing_case_id_idx")
  @@index([firmId], map: "qualify_ai_processing_firm_id_idx")
  @@map("qualify_ai_processings")
}

model QualifyAiProcessedDocument {
  id                    String              @id @default(uuid()) @db.Uuid
  qualifyAiProcessingId String              @map("qualify_ai_processing_id") @db.Uuid
  qualifyAiProcessing   QualifyAiProcessing @relation(fields: [qualifyAiProcessingId], references: [id])
  documentId            String              @map("document_id") @db.Uuid
  document              Document            @relation(fields: [documentId], references: [id])
  pageCount             Int                 @map("page_count")

  @@unique([qualifyAiProcessingId, documentId], map: "qualify_ai_processed_doc_unique")
  @@index([documentId], map: "qualify_ai_processed_document_document_id_idx")
  @@map("qualify_ai_processed_documents")
}

model QualifyAiQualifierDocument {
  id         String   @id @default(uuid()) @db.Uuid
  firmId     String   @map("firm_id") @db.Uuid
  firm       Firm     @relation(fields: [firmId], references: [id])
  tortName   String   @map("tort_name") @db.VarChar(255)
  fileName   String   @map("file_name") @db.VarChar(255)
  s3Key      String   @map("s3_key") @db.VarChar(1024)
  uploadedBy String   @map("uploaded_by") @db.Uuid
  uploader   User     @relation("qualifyAiUploads", fields: [uploadedBy], references: [id])
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([firmId, tortName], map: "qualify_ai_qualifier_doc_firm_tort_idx")
  @@map("qualify_ai_qualifier_documents")
}
