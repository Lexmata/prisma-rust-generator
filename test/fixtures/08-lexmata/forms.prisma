// Form templates, versions, intake submissions and exports.

enum FormTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  EMAIL
  PHONE
  CHECKBOX
  RADIO
  DROPDOWN
  FILE_UPLOAD
  SIGNATURE
  ADDRESS
  RICH_TEXT
  SECTION_HEADER
}

enum DistributionStatus {
  PENDING
  OPENED
  SUBMITTED
  EXPIRED
  REVOKED
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  RESUBMISSION_REQUESTED
}

model FormTemplate {
  id             String                @id @default(uuid()) @map("id") @db.Uuid
  firmId         String                @map("firm_id") @db.Uuid
  firm           Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name           String                @map("name") @db.VarChar(255)
  description    String?               @map("description") @db.Text
  status         FormTemplateStatus    @default(DRAFT) @map("status")
  currentVersion Int                   @default(1) @map("current_version") @db.Integer
  createdById    String                @map("created_by_id") @db.Uuid
  createdBy      User                  @relation("formTemplateCreator", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  versions       FormTemplateVersion[]
  distributions  FormDistribution[]
  submissions    FormSubmission[]

  @@index([firmId], map: "form_template_firm_id_idx")
  @@index([createdById], map: "form_template_created_by_id_idx")
  @@map("form_templates")
}

model FormTemplateVersion {
  id            String             @id @default(uuid()) @map("id") @db.Uuid
  templateId    String             @map("template_id") @db.Uuid
  template      FormTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  versionNumber Int                @map("version_number") @db.Integer
  schema        Json               @map("schema")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  distributions FormDistribution[]
  submissions   FormSubmission[]

  @@unique([templateId, versionNumber], map: "form_template_version_template_version_unique")
  @@index([templateId], map: "form_template_version_template_id_idx")
  @@map("form_template_versions")
}

model FormDistribution {
  id                String              @id @default(uuid()) @map("id") @db.Uuid
  templateId        String              @map("template_id") @db.Uuid
  template          FormTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  templateVersionId String              @map("template_version_id") @db.Uuid
  templateVersion   FormTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  firmId            String              @map("firm_id") @db.Uuid
  firm              Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  clientEmail       String              @map("client_email") @db.VarChar(255)
  clientName        String              @map("client_name") @db.VarChar(255)
  token             String              @unique @map("token") @db.VarChar(64)
  expiresAt         DateTime            @map("expires_at") @db.Timestamp(6)
  status            DistributionStatus  @default(PENDING) @map("status")
  singleUse         Boolean             @default(true) @map("single_use") @db.Boolean
  createdById       String              @map("created_by_id") @db.Uuid
  createdBy         User                @relation("formDistributionCreator", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  submittedAt       DateTime?           @map("submitted_at") @db.Timestamp(6)
  submissions       FormSubmission[]

  @@index([templateId], map: "form_distribution_template_id_idx")
  @@index([firmId], map: "form_distribution_firm_id_idx")
  @@index([token], map: "form_distribution_token_idx")
  @@index([createdById], map: "form_distribution_created_by_idx")
  @@map("form_distributions")
}

model FormSubmission {
  id                String              @id @default(uuid()) @map("id") @db.Uuid
  distributionId    String              @map("distribution_id") @db.Uuid
  distribution      FormDistribution    @relation(fields: [distributionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  templateId        String              @map("template_id") @db.Uuid
  template          FormTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  templateVersionId String              @map("template_version_id") @db.Uuid
  templateVersion   FormTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  firmId            String              @map("firm_id") @db.Uuid
  firm              Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  data              Json                @map("data") @db.JsonB
  status            SubmissionStatus    @default(SUBMITTED) @map("status")
  submittedAt       DateTime            @default(now()) @map("submitted_at") @db.Timestamp(6)
  verifiedAt        DateTime?           @map("verified_at") @db.Timestamp(6)
  verifiedById      String?             @map("verified_by_id") @db.Uuid
  verifiedBy        User?               @relation("formSubmissionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  notes             SubmissionNote[]
  pdfUploads        PdfUpload[]

  @@index([distributionId], map: "form_submission_distribution_id_idx")
  @@index([templateId], map: "form_submission_template_id_idx")
  @@index([firmId], map: "form_submission_firm_id_idx")
  @@map("form_submissions")
}

model SubmissionNote {
  id           String         @id @default(uuid()) @map("id") @db.Uuid
  submissionId String         @map("submission_id") @db.Uuid
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  content      String         @map("content") @db.Text
  createdById  String         @map("created_by_id") @db.Uuid
  createdBy    User           @relation("submissionNoteCreator", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([submissionId], map: "submission_note_submission_id_idx")
  @@map("submission_notes")
}
