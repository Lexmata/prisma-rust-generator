// Documents, document blocks, tags, search templates, default search terms.

enum FieldReviewStatus {
  PENDING
  ACCEPTED
  CORRECTED
  REJECTED
}

enum DocumentType {
  MEDICAL_RECORDS
  POLICE_REPORT
  CALCULATED_FUTURE_MEDICAL_EXPENSES
  LOST_WAGES
  PAIN_AND_SUFFERING
  OTHER_DAMAGES
  UNKNOWN
}

model DocumentBlock {
  id               Int       @id @default(autoincrement()) @map("id") @db.Integer
  documentId       String?   @map("document_id") @db.Uuid
  pageNumber       Int?      @map("page_number") @db.Integer
  blockType        String    @map("block_type") @db.VarChar(32)
  confidence       Decimal?  @map("confidence") @db.Decimal(16, 2)
  blockText        String?   @map("block_text") @db.Text
  blockTextClean   String?   @map("block_text_clean") @db.Text
  blockTextType    String?   @map("block_text_type") @db.VarChar(11)
  /// @ent.json object
  blockGeometry    Json      @map("block_geometry")
  blockId          String    @map("block_id") @db.VarChar(36)
  /// @ent.json object
  relationships    Json?     @map("relationships")
  relationshipsIds String?   @map("relationships_ids")
  /// @ent.json object
  entities         Json?     @map("entities")
  blockRowIndex    Int       @default(0) @map("block_row_index") @db.Integer
  blockColumnIndex Int       @default(0) @map("block_column_index") @db.Integer
  document         Document? @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "document_blocks_document_id_fk")

  @@index([documentId, pageNumber, blockTextClean], map: "document_id_page_number_block_text_clean_index")
  @@map("document_blocks")
}

model Document {
  id                          String                       @id @map("id") @db.Uuid
  userId                      String                       @map("user_id") @db.Uuid
  user                        User                         @relation("documents", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "documents_user_id_fkey")
  fileName                    String                       @map("file_name") @db.VarChar(200)
  mimeType                    String                       @map("mime_type") @db.VarChar(100)
  /// @FieldType({name: 'GraphQLBigInt', from: 'graphql-scalars', output: true })
  fileSize                    BigInt                       @default(0) @map("file_size") @db.BigInt
  pageCount                   Int                          @default(0) @map("page_count") @db.Integer
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                   DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  uploadedAt                  DateTime                     @default(now()) @map("uploaded_at") @db.Timestamp(6)
  billedAt                    DateTime?                    @map("billed_at") @db.Timestamp(6)
  deletedAt                   DateTime?                    @map("deleted_at") @db.Timestamp(6)
  deleteDocument              Boolean                      @default(false) @map("delete_document") @db.Boolean
  isFrozen                    Boolean                      @default(false) @map("is_frozen") @db.Boolean
  paid                        Boolean                      @default(false) @map("paid") @db.Boolean
  invoiceId                   String                       @map("invoice_id") @db.Uuid
  invoice                     Invoice                      @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  demandLetterId              String?                      @map("demand_letter_id") @db.Uuid
  demandLetter                DemandLetter?                @relation(fields: [demandLetterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  documentType                DocumentType                 @default(MEDICAL_RECORDS) @map("document_type")
  caseId                      String                       @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @map("case_id") @db.Uuid
  case                        Case?                        @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  documentBlocks              DocumentBlock[]
  searchProcessing            SearchProcessing[]
  firm                        Firm                         @relation(fields: [firmId], references: [id])
  firmId                      String                       @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @map("firm_id") @db.Uuid
  /// @ent.json array
  illegiblePages              Json                         @default("[]") @map("illegible_pages") @db.JsonB
  /// @ent.json array
  tags                        Json?                        @db.JsonB
  lineItems                   LineItem[]
  // Parent-child document relations for RAG chunking
  childRelations              DocumentRelation[]           @relation("ParentDocument")
  parentRelations             DocumentRelation[]           @relation("ChildDocument")
  advitaTrackingMappings      AdvitaTrackingMapping[]
  qualifyAiProcessedDocuments QualifyAiProcessedDocument[]

  @@unique([id, userId], map: "document_file_uuid")
  @@index([invoiceId], map: "document_invoice_id_idx")
  @@index([caseId], map: "document_case_id_idx")
  @@map("documents")
}

model DocumentSearchTemplate {
  id           Int      @id @default(autoincrement())
  templateName String   @map("template_name") @db.VarChar(100)
  /// @ent.json array
  terms        Json     @map("terms") @db.JsonB
  hexColor     String?  @map("hex_color") @db.VarChar(7)
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation("document_search_templates", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "document_search_templates_user_id_fkey")
  firmId       String?  @map("firm_id") @db.Uuid
  firm         Firm?    @relation("document_search_templates", fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  global       Boolean  @default(false) @map("global")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("document_search_templates")
}

model DefaultSearchTerm {
  id           Int      @id @default(autoincrement()) @map("id")
  templateName String   @map("template_name") @db.VarChar(128)
  /// @ent.json array
  terms        Json?    @map("terms")
  hexColor     String?  @map("hex_color") @db.VarChar(7)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("default_search_terms")
}

model DocumentTag {
  id             Int     @id @default(autoincrement()) @map("id")
  userId         String  @map("user_id") @db.Uuid
  tagName        String  @unique @map("tag_name") @db.VarChar(255)
  tagDescription String? @map("tag_description") @db.VarChar(255)
  user           User    @relation("document_tags", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "document_tags_user_id_fkey")

  @@unique([userId, tagName], map: "document_tags_rb_user_id_tag_name_uindex")
  @@map("document_tags")
}

model DocumentRelation {
  id               String   @id @default(uuid()) @map("id") @db.Uuid
  parentDocumentId String   @map("parent_document_id") @db.Uuid
  childDocumentId  String   @map("child_document_id") @db.Uuid
  chunkIndex       Int      @map("chunk_index") @db.Integer
  startPage        Int      @map("start_page") @db.Integer
  endPage          Int      @map("end_page") @db.Integer
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  parentDocument Document @relation("ParentDocument", fields: [parentDocumentId], references: [id], onDelete: Cascade)
  childDocument  Document @relation("ChildDocument", fields: [childDocumentId], references: [id], onDelete: Cascade)

  @@unique([parentDocumentId, chunkIndex], map: "document_relation_parent_chunk_unique")
  @@index([parentDocumentId], map: "document_relation_parent_id_idx")
  @@index([childDocumentId], map: "document_relation_child_id_idx")
  @@map("document_relations")
}
