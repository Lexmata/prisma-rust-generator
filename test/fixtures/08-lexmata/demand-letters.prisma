// Demand letters generation pipeline.

model DemandLetter {
  id               String                  @id @default(uuid()) @map("id") @db.Uuid
  firmId           String                  @map("firm_id") @db.Uuid
  firm             Firm                    @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  /// @ent.json object
  uploadForm       Json                    @map("upload_form") @db.Json
  documents        Document[]
  caseId           String                  @map("case_id") @db.Uuid
  case             Case                    @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  processingStatus ProcessingStatus        @default(PENDING) @map("processing_status")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  lineItems        LineItem[]
  processing       DemandLetterProcessing?

  @@index([firmId], map: "demand_letter_firm_id_idx")
  @@index([caseId], map: "demand_letter_case_id_idx")
  @@map("demand_letters")
}

model DemandLetterProcessing {
  id                      Int              @id @default(autoincrement()) @map("id")
  demandLetterId          String           @unique @map("demand_letter_id") @db.Uuid
  demandLetter            DemandLetter     @relation(fields: [demandLetterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  caseId                  String           @map("case_id") @db.Uuid
  case                    Case             @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  firmId                  String           @map("firm_id") @db.Uuid
  firm                    Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  processingStatus        ProcessingStatus @default(PENDING) @map("processing_status")
  startedAt               DateTime?        @default(now()) @map("started_at") @db.Timestamp(6)
  completedAt             DateTime?        @map("completed_at") @db.Timestamp(6)
  processingStatusMessage String?          @map("processing_status_message") @db.VarChar(255)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([firmId], map: "demand_letter_processing_firm_id_idx")
  @@index([caseId], map: "demand_letter_processing_case_id_idx")
  @@map("demand_letter_processings")
}
