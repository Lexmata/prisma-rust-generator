// PDF processing jobs and standalone OCR pipeline.

enum PdfProcessingStatus {
  PENDING
  EXTRACTING_TEXT
  AI_PROCESSING
  REVIEW_PENDING
  REVIEWED
  FAILED
}

enum StandaloneOcrJobStatus {
  PENDING
  PAID
  UPLOADING
  PROCESSING
  COMPLETE
  ERROR
}

model StandaloneOcrJob {
  id              String                 @id @default(uuid()) @map("id") @db.Uuid
  jobToken        String                 @unique @map("job_token") @db.VarChar(255)
  status          StandaloneOcrJobStatus @default(PENDING) @map("status")
  fileName        String                 @map("file_name") @db.VarChar(500)
  pageCount       Int                    @map("page_count") @db.Integer
  s3InputKey      String?                @map("s3_input_key") @db.VarChar(1000)
  s3OutputKey     String?                @map("s3_output_key") @db.VarChar(1000)
  stripeSessionId String?                @map("stripe_session_id") @db.VarChar(255)
  customerEmail   String?                @map("customer_email") @db.VarChar(320)
  priceCents      Int                    @map("price_cents") @db.Integer
  errorMessage    String?                @map("error_message") @db.Text
  expiresAt       DateTime               @map("expires_at") @db.Timestamp(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([jobToken], map: "standalone_ocr_jobs_job_token_idx")
  @@index([status], map: "standalone_ocr_jobs_status_idx")
  @@index([stripeSessionId], map: "standalone_ocr_jobs_stripe_session_id_idx")
  @@index([expiresAt], map: "standalone_ocr_jobs_expires_at_idx")
  @@map("standalone_ocr_jobs")
}

model BatchFile {
  id        String   @id @map("id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fileName  String   @map("file_name") @db.VarChar(200)
  s3Key     String?  @map("s3_key") @db.VarChar(500)
  mimeType  String   @map("mime_type") @db.VarChar(100)
  /// @FieldType({name: 'GraphQLBigInt', from: 'graphql-scalars', output: true })
  fileSize  BigInt   @map("file_size") @db.BigInt
  fileCount Int      @map("file_count") @db.Integer
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  // FK constraint name pinned via `map:` so it survives the LD-24 table
  // rename verbatim (batch_file -> batch_files). Intentional, not a
  // missed pluralisation — keeping the existing DB name avoids a
  // pointless ALTER on a constraint that only references a column name.
  user      User     @relation("batch_file", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "batch_file_user_id_fkey")
  caseId    String?  @map("case_id") @db.Uuid
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([id, userId], map: "batch_file_file_uuid")
  @@index([caseId], map: "batch_file_case_id_idx")
  @@map("batch_files")
}

model PdfUpload {
  id           String              @id @default(uuid()) @map("id") @db.Uuid
  submissionId String              @map("submission_id") @db.Uuid
  submission   FormSubmission      @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  firmId       String              @map("firm_id") @db.Uuid
  firm         Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  s3Key        String              @map("s3_key") @db.VarChar(500)
  fileName     String              @map("file_name") @db.VarChar(255)
  pageCount    Int?                @map("page_count") @db.Integer
  hasText      Boolean?            @map("has_text") @db.Boolean
  status       PdfProcessingStatus @default(PENDING) @map("status")
  errorMessage String?             @map("error_message") @db.Text
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  extractions  PdfExtraction[]

  @@index([submissionId], map: "pdf_upload_submission_id_idx")
  @@index([firmId], map: "pdf_upload_firm_id_idx")
  @@map("pdf_uploads")
}

model PdfExtraction {
  id               String                 @id @default(uuid()) @map("id") @db.Uuid
  pdfUploadId      String                 @map("pdf_upload_id") @db.Uuid
  pdfUpload        PdfUpload              @relation(fields: [pdfUploadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  extractedText    String?                @map("extracted_text") @db.Text
  extractedFields  Json?                  @map("extracted_fields") @db.JsonB
  confidenceScores Json?                  @map("confidence_scores") @db.JsonB
  processingMethod String                 @map("processing_method") @db.VarChar(50)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  fieldReviews     ExtractedFieldReview[]

  @@index([pdfUploadId], map: "pdf_extraction_pdf_upload_id_idx")
  @@map("pdf_extractions")
}

model ExtractedFieldReview {
  id             String            @id @default(uuid()) @map("id") @db.Uuid
  extractionId   String            @map("extraction_id") @db.Uuid
  extraction     PdfExtraction     @relation(fields: [extractionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fieldId        String            @map("field_id") @db.VarChar(255)
  originalValue  String?           @map("original_value") @db.Text
  correctedValue String?           @map("corrected_value") @db.Text
  status         FieldReviewStatus @default(PENDING) @map("status")
  reviewedById   String?           @map("reviewed_by_id") @db.Uuid
  reviewedBy     User?             @relation("fieldReviewReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reviewedAt     DateTime?         @map("reviewed_at") @db.Timestamp(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([extractionId], map: "extracted_field_review_extraction_id_idx")
  @@map("extracted_field_reviews")
}
