// Qualification criteria, mappings, and tort templates.

// ─── Qualification Verdict ─────────────────────────────────────────────────────

enum QualificationCriteriaStatus {
  PENDING_INGESTION
  INGESTED
  FAILED
}

enum QualificationVerdict {
  QUALIFIED
  NOT_QUALIFIED
  INSUFFICIENT_EVIDENCE
}

enum TortTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("tort_template_status")
}

/// Registry of tort-specific qualification criteria documents in the Bedrock KB.
/// Tracks both firm-uploaded memorandums and auto-discovered web content.
model QualificationCriteria {
  id           String                      @id @default(uuid()) @map("id") @db.Uuid
  tortType     String                      @map("tort_type") @db.VarChar(255)
  firmId       String?                     @map("firm_id") @db.Uuid
  firm         Firm?                       @relation(fields: [firmId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  title        String                      @map("title") @db.VarChar(500)
  sourceUrl    String?                     @map("source_url") @db.VarChar(2000)
  s3Key        String                      @map("s3_key") @db.VarChar(1000)
  kbDocumentId String?                     @map("kb_document_id") @db.VarChar(255)
  status       QualificationCriteriaStatus @default(PENDING_INGESTION) @map("status")
  createdAt    DateTime                    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([tortType], map: "qualification_criteria_tort_type_idx")
  @@index([firmId, tortType], map: "qualification_criteria_firm_tort_idx")
  @@index([status], map: "qualification_criteria_status_idx")
  @@map("qualification_criteria")
}

/// Stores the qualification verdict for a case against a specific mass tort.
/// Supports re-runs via the supersededById chain — when new documents arrive
/// and the case is re-qualified, the previous row points to the new one.
model CaseQualification {
  id                  String               @id @default(uuid()) @map("id") @db.Uuid
  caseId              String               @map("case_id") @db.Uuid
  case                Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  firmId              String               @map("firm_id") @db.Uuid
  firm                Firm                 @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tortType            String               @map("tort_type") @db.VarChar(255)
  verdict             QualificationVerdict @map("verdict")
  confidenceScore     Float                @map("confidence_score")
  summary             String               @map("summary") @db.Text
  /// @ent.json object
  prosJson            Json                 @map("pros_json") @db.JsonB
  /// @ent.json object
  consJson            Json                 @map("cons_json") @db.JsonB
  /// @ent.json object
  flagsJson           Json                 @map("flags_json") @db.JsonB
  reportS3Key         String               @map("report_s3_key") @db.VarChar(1000)
  /// @ent.json array
  criteriaUsed        Json                 @map("criteria_used") @db.JsonB
  webSearchUsed       Boolean              @default(false) @map("web_search_used")
  documentsHash       String               @map("documents_hash") @db.VarChar(64)
  /// @ent.json array
  documentIds         Json                 @map("document_ids") @db.JsonB
  templateId          String?              @map("template_id") @db.Uuid
  templateVersion     String?              @map("template_version") @db.VarChar(64)
  templateContentHash String?              @map("template_content_hash") @db.Char(64)
  template            TortTemplate?        @relation("templateCaseQualifications", fields: [templateId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supersededById      String?              @map("superseded_by_id") @db.Uuid
  supersededBy        CaseQualification?   @relation("QualificationSupersession", fields: [supersededById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supersedes          CaseQualification[]  @relation("QualificationSupersession")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([caseId], map: "case_qualification_case_id_idx")
  @@index([caseId, tortType], map: "case_qualification_case_tort_idx")
  @@index([firmId], map: "case_qualification_firm_id_idx")
  @@index([supersededById], map: "case_qualification_superseded_idx")
  @@map("case_qualifications")
}

/// Catalog of tort-specific JSON templates that drive the template-driven
/// qualify pipeline. Each row is one (tortType, firmId, version) tuple;
/// firmId null = Lexmata-maintained base template; set = firm override.
/// The JSON blob lives in S3 at the recorded s3Bucket/s3Key; contentHash
/// lets the worker fail fast on DB/S3 drift before trusting a template.
model TortTemplate {
  id            String             @id @default(uuid()) @map("id") @db.Uuid
  tortType      String             @map("tort_type") @db.VarChar(255)
  firmId        String?            @map("firm_id") @db.Uuid
  version       String             @map("version") @db.VarChar(64)
  displayName   String             @map("display_name") @db.VarChar(255)
  schemaVersion String             @map("schema_version") @db.VarChar(16)
  s3Bucket      String             @map("s3_bucket") @db.VarChar(255)
  s3Key         String             @map("s3_key") @db.VarChar(1000)
  contentHash   String             @map("content_hash") @db.Char(64)
  status        TortTemplateStatus @map("status")
  publishedAt   DateTime?          @map("published_at") @db.Timestamp(6)
  /// Audit snapshot of whoever published this row. Intentionally a free-text
  /// VARCHAR rather than a FK to User: the publisher can be a Lexmata
  /// engineer, a firm admin, a CI job, or a removed user, and we need the
  /// trail to survive account deletion.
  publishedBy   String?            @map("published_by") @db.VarChar(255)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  firm               Firm?               @relation("firmTortTemplates", fields: [firmId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  caseQualifications CaseQualification[] @relation("templateCaseQualifications")

  @@unique([tortType, firmId, version], map: "tort_template_tort_firm_version_key")
  @@index([tortType, firmId, status], map: "tort_template_tort_firm_status_idx")
  @@index([tortType, status], map: "tort_template_tort_status_idx")
  @@map("tort_templates")
}
