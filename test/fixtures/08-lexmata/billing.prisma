// Invoices, line items, pricing, Stripe-facing billing models.

enum InvoiceStatus {
  PAID
  UNPAID
}

model Invoice {
  id                  String                @id @default(uuid()) @map("id") @db.Uuid
  amount              Decimal               @default(0.00) @map("amount") @db.Decimal(16, 2)
  tax                 Decimal               @default(0.00) @map("tax") @db.Decimal(16, 2)
  total               Decimal               @default(0.00) @map("total") @db.Decimal(16, 2)
  status              InvoiceStatus         @default(UNPAID) @map("status")
  processingTier      ProcessingTier        @default(IDENTIFICATION) @map("processing_tier")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  paidAt              DateTime?             @map("paid_at") @db.Timestamp(6)
  userId              String                @map("user_id") @db.Uuid
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  firmId              String                @map("firm_id") @db.Uuid
  firm                Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  caseId              String?               @map("case_id") @db.Uuid
  case                Case?                 @relation(fields: [caseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  documents           Document[]
  lineItems           LineItem[]
  paymentIntentId     String?               @map("payment_intent_id") @db.VarChar(255)
  qualifyAiProcessing QualifyAiProcessing[]

  @@index([firmId], map: "invoice_firm_id_idx")
  @@index([caseId], map: "invoice_case_id_idx")
  @@map("invoices")
}

// Intentionally singular `@@map`: "pricing" is a mass noun and
// pluralising to "pricings" reads awkwardly. Exempt from LD-24's
// pluralisation sweep by design.
model Pricing {
  id          Int     @id @default(autoincrement()) @map("id")
  priceName   String  @map("price_name") @db.VarChar(255)
  priceAmount Decimal @map("price_amount") @db.Decimal(16, 2)
  threshold   Int     @map("threshold")

  @@map("pricing")
}

model LineItem {
  id             String        @id @default(uuid()) @map("id") @db.Uuid
  amount         Decimal       @map("amount") @db.Decimal(16, 2)
  // Document relation
  documentId     String?       @map("document_id") @db.Uuid
  document       Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // Demand Letter relation
  demandLetterId String?       @map("demand_letter_id") @db.Uuid
  demandLetter   DemandLetter? @relation(fields: [demandLetterId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // Invoice relation
  invoiceId      String?       @map("invoice_id") @db.Uuid
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // Metadata
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([documentId], map: "line_items_document_id_idx")
  @@index([demandLetterId], map: "line_items_demand_letter_id_idx")
  @@index([invoiceId], map: "line_items_invoice_id_idx")
  @@map("line_items")
}
