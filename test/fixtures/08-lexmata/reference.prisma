// Reference / lookup data: addresses, API integrations, etc.

model Address {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  line1     String   @map("line1") @db.VarChar(255)
  line2     String?  @map("line2") @db.VarChar(255)
  city      String   @map("city") @db.VarChar(50)
  state     String   @map("state") @db.VarChar(2)
  zip       String   @map("zip") @db.VarChar(10)
  country   String   @map("country") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  firm      Firm?

  @@map("addresses")
}

model Rag {
  id              String                      @id @default(uuid()) @map("id") @db.Uuid
  text            String                      @map("text") @db.Text
  /// @ent.json object
  metadata        Json                        @map("metadata") @db.JsonB
  vectorEmbedding Unsupported("vector(1024)") @map("vector_embedding")
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  firmId          String                      @map("firm_id") @db.Text
  documentId      String                      @map("document_id") @db.Text
  caseId          String                      @map("case_id") @db.Text
  fileName        String                      @map("file_name") @db.VarChar(255)
  documentType    String                      @map("document_type") @db.VarChar(255)
  fileType        String                      @map("file_type") @db.VarChar(255)
  contentType     String                      @map("content_type") @db.VarChar(255)
  pageNumber      String                      @map("page_number") @db.Text

  // Parent-child chunking fields
  chunkType  String  @default("child") @map("chunk_type") @db.VarChar(10) // 'parent' or 'child'
  chunkIndex Int     @default(0) @map("chunk_index") // ordering within document
  parentId   String? @map("parent_id") @db.Uuid // null for parent chunks
  tokenCount Int?    @map("token_count") // useful for context budgeting

  // Self-relation for parent-child
  parent   Rag?  @relation("ChunkHierarchy", fields: [parentId], references: [id])
  children Rag[] @relation("ChunkHierarchy")

  @@index([parentId])
  @@index([caseId, chunkType])
  @@index([documentId, chunkIndex])
  @@map("cardozo_knowledge_bases")
}

// Payer/program for a row in `hcpcs_fees`. Federal Medicare (CMS) and Florida
// Workers' Compensation rule-based schedules share the HCPCS-keyed shape;
// payer-specific fields live in adjunct tables (medicare_fee_details,
// florida_wc_fee_details).
enum FeePayer {
  MEDICARE
  FL_WC_PHYSICIAN   // FL DWC 69L-7.020 Health Care Provider Reimbursement Manual
  FL_WC_ASC         // FL DWC 69L-7.100 Ambulatory Surgical Center manual
  FL_WC_HOSPITAL_OP // FL DWC 69L-7.501 hospital outpatient scheduled portion
}

model HcpcsFee {
  id             String    @id @default(uuid()) @map("id") @db.Uuid
  payer          FeePayer  @map("payer")
  hcpcsCode      String    @map("hcpcs_code") @db.VarChar(5)
  modifier       String?   @map("modifier") @db.VarChar(2)
  description    String?   @map("description") @db.VarChar(255)
  nonFacilityFee Decimal?  @map("non_facility_fee") @db.Decimal(10, 2)
  facilityFee    Decimal?  @map("facility_fee") @db.Decimal(10, 2)
  // Date-range form so Medicare quarterly and FL rule-effective cadences fit one shape.
  effectiveStart DateTime  @map("effective_start") @db.Date
  effectiveEnd   DateTime? @map("effective_end") @db.Date
  jurisdiction   String?   @map("jurisdiction") @db.VarChar(2)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  medicareDetail  MedicareFeeDetail?
  floridaWcDetail FloridaWcFeeDetail?

  @@unique([payer, hcpcsCode, modifier, effectiveStart, jurisdiction], map: "hcpcs_fees_payer_code_mod_start_jur_key")
  @@index([payer, hcpcsCode], map: "hcpcs_fees_payer_code_idx")
  @@index([payer, hcpcsCode, modifier], map: "hcpcs_fees_payer_code_mod_idx")
  @@map("hcpcs_fees")
}

model MedicareFeeDetail {
  id               String   @id @default(uuid()) @map("id") @db.Uuid
  hcpcsFeeId       String   @unique @map("hcpcs_fee_id") @db.Uuid
  hcpcsFee         HcpcsFee @relation(fields: [hcpcsFeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  statusCode       String?  @map("status_code") @db.VarChar(1)
  workRvu          Decimal? @map("work_rvu") @db.Decimal(8, 4)
  nonFacilityPeRvu Decimal? @map("non_facility_pe_rvu") @db.Decimal(8, 4)
  facilityPeRvu    Decimal? @map("facility_pe_rvu") @db.Decimal(8, 4)
  malpracticeRvu   Decimal? @map("malpractice_rvu") @db.Decimal(8, 4)
  nonFacilityTotal Decimal? @map("non_facility_total") @db.Decimal(8, 4)
  facilityTotal    Decimal? @map("facility_total") @db.Decimal(8, 4)
  conversionFactor Decimal  @map("conversion_factor") @db.Decimal(8, 4)
  globalDays       String?  @map("global_days") @db.VarChar(3)
  effectiveYear    Int      @map("effective_year") @db.SmallInt
  effectiveQuarter String   @map("effective_quarter") @db.VarChar(2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("medicare_fee_details")
}

model FloridaWcFeeDetail {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  hcpcsFeeId      String   @unique @map("hcpcs_fee_id") @db.Uuid
  hcpcsFee        HcpcsFee @relation(fields: [hcpcsFeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ruleNumber      String   @map("rule_number") @db.VarChar(20)
  manualEdition   String   @map("manual_edition") @db.VarChar(20)
  category        String?  @map("category") @db.VarChar(40)
  // "By Report" — fee determined per-case from the report; no fixed dollar amount.
  byReport        Boolean  @default(false) @map("by_report")
  ascPaymentGroup String?  @map("asc_payment_group") @db.VarChar(10)
  notes           String?  @map("notes") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("florida_wc_fee_details")
}

// Hospital inpatient reimbursement under FL DWC 69L-7.501. Not HCPCS-keyed:
// hospitals are reimbursed via per-diem rates with stop-loss outlier rules,
// scoped by county and hospital category (trauma, non-trauma, psychiatric,
// rehab, etc.).
model FloridaWcHospitalInpatientRate {
  id                 String    @id @default(uuid()) @map("id") @db.Uuid
  county             String    @map("county") @db.VarChar(50)
  hospitalCategory   String    @map("hospital_category") @db.VarChar(40)
  perDiemRate        Decimal   @map("per_diem_rate") @db.Decimal(10, 2)
  stopLossThreshold  Decimal?  @map("stop_loss_threshold") @db.Decimal(12, 2)
  stopLossMultiplier Decimal?  @map("stop_loss_multiplier") @db.Decimal(6, 4)
  effectiveStart     DateTime  @map("effective_start") @db.Date
  effectiveEnd       DateTime? @map("effective_end") @db.Date
  ruleNumber         String    @map("rule_number") @db.VarChar(20)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([county, hospitalCategory], map: "fl_wc_hosp_inpat_county_cat_idx")
  @@index([effectiveStart, effectiveEnd], map: "fl_wc_hosp_inpat_effective_idx")
  @@map("florida_wc_hospital_inpatient_rates")
}

model Icd10Code {
  id               String   @id @default(uuid()) @map("id") @db.Uuid
  code             String   @map("code") @db.VarChar(7)
  shortDescription String   @map("short_description") @db.VarChar(80)
  longDescription  String   @map("long_description") @db.Text
  effectiveYear    Int      @map("effective_year") @db.SmallInt
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([code, effectiveYear], map: "icd10_code_year_key")
  @@index([code], map: "icd10_code_idx")
  @@map("icd10_codes")
}

model MedicareGpci {
  id            String   @id @default(uuid()) @map("id") @db.Uuid
  localityCode  String   @map("locality_code") @db.VarChar(2)
  localityName  String   @map("locality_name") @db.VarChar(100)
  state         String?  @map("state") @db.VarChar(2)
  workGpci      Decimal  @map("work_gpci") @db.Decimal(6, 4)
  peGpci        Decimal  @map("pe_gpci") @db.Decimal(6, 4)
  mpGpci        Decimal  @map("mp_gpci") @db.Decimal(6, 4)
  effectiveYear Int      @map("effective_year") @db.SmallInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([localityCode, effectiveYear], map: "medicare_gpci_locality_year_key")
  @@index([state], map: "medicare_gpci_state_idx")
  @@map("medicare_gpcis")
}
