{
  "name": "@lexmata/prisma-rust-generator",
  "version": "0.2.0",
  "description": "Prisma generator emitting bare Rust models, enums, filters, and the full Prisma input surface.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "prisma-rust-generator": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "bash scripts/verify-rust.sh",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.3",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@prisma/generator-helper": "^5.22.0",
    "@prisma/internals": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "prisma",
    "generator",
    "rust",
    "codegen"
  ]
}
